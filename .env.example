# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for metadata, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.mu

# Signs login sessions. REQUIRED in production: 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin password hashes (never the plain password).
# Generate: node scripts/hash-password.mjs "new password of 12+ characters"
ADMIN_KRIT_PASSWORD_HASH=
ADMIN_ANKIT_PASSWORD_HASH=
ADMIN_INESH_PASSWORD_HASH=

# Demo owner accounts (Sophie, Hamilton) shown on the sign-in page so visitors
# can try the portal. Set to false to switch them off.
DEMO_MODE=true

# Let search engines index the site. Keep false until the demo content
# review is done; set true at launch.
SITE_INDEXABLE=false

# Contact form email delivery (https://resend.com). Required in production:
# without a key, the form tells visitors it could not send and shows the
# direct email and phone numbers instead.
RESEND_API_KEY=
# Where enquiries go (defaults to PUBLIC_EMAIL in data/site.ts, which is
# BellavereLtd@gmail.com until hello@bellaveremu.com has a mailbox).
CONTACT_TO_EMAIL=BellavereLtd@gmail.com
# Sender. Leave empty to use Resend's test sender, which only delivers to the
# address the Resend account was created with. After verifying the domain in
# Resend, set e.g.: Bellavere website <website@bellaveremu.com>
CONTACT_FROM_EMAIL=

# Privacy-friendly analytics (https://plausible.io): the site's domain as
# registered in Plausible, e.g. www.bellaveremu.com. Leave empty for no
# analytics (no script is loaded and track() does nothing).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
