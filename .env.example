# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for metadata, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.mu

# Signs login sessions. REQUIRED in production: 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin password hashes (never the plain password).
# Generate: node scripts/hash-password.mjs "new password of 12+ characters"
ADMIN_KRIT_PASSWORD_HASH=
ADMIN_ANKIT_PASSWORD_HASH=
ADMIN_INESH_PASSWORD_HASH=

# Demo owner accounts (Sophie, Ravi, Hamilton). Set to false at launch.
DEMO_MODE=true

# Let search engines index the site. Keep false until the demo content
# (listings, testimonials, placeholders) is replaced; set true at launch.
SITE_INDEXABLE=false
